ring name=\"settings_heading\">Settings</string>\r\n    <string name=\"settings_title\">Appearance</string>\r\n    <string name=\"tv_settings_language_title\">Select Language</string>\r\n    <string name=\"tv_settings_select_color\">Select color</string>\r\n    <string name=\"tv_settings_settings_sensor\">Sensor settings</string>\r\n    <string name=\"tv_settings_step_counter\">Step counter</string>\r\n    <string name=\"tv_settings_accel\">Accelerometer</string>\r\n    <string name=\"tv_settings_geo_tagging\" translatable=\"false\">GPS</string>\r\n    <string name=\"tv_settings_notification_title\">Notifications settings</string>\r\n    <string name=\"tv_settings_morning_notification\">Morning</string>\r\n    <string name=\"tv_settings_noon_notification\">Noon</string>\r\n    <string name=\"tv_settings_evening_notification\">Evening</string>\r\n    <string name=\"bt_settings_delete_data\">delete all personal data</string>\r\n\r\n    <!-- Strings for the questionnaire activity-->\r\n    <string name=\"bt_send\">Send</string>\r\n    <string name=\"tv_questionnaire_q8_2\">Since the last questionnaire, I have been angry or aggressive to another person, which I regretted later on.</string>\r\n    <string name=\"tv_questionnaire_q8_1\">Since the last questionnaire, I reacted impulsive – meaning I acted without thinking about potential consequences.</string>\r\n    <string name=\"tv_questionnaire_q7_2\">Currently I think about myself that I am a failure.</string>\r\n    <string name=\"tv_questionnaire_q7_1\">Currently I’m satisfied with myself.</string>\r\n    <string name=\"tv_questionnaire_q6_4\">For a long time after I got into a fight or a disagreement is settled, my thoughts about these events resurface.</string>\r\n    <string name=\"tv_questionnaire_q6_3\">Sometimes I have a hard time to stop thinking about myself.</string>\r\n    <string name=\"tv_questionnaire_q6_2\">I often have the feeling that things resurface in my head that I have said or done in the past.</