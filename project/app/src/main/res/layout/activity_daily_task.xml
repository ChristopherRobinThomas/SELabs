<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DailyTaskActivity"
    android:id="@+id/dailyTaskActivity">

    <TextView
        android:id="@+id/pickDailyGoalTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick your Daily Goal!"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_marginTop="20dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/pickDailyGoalTxt"
        android:layout_marginTop="-50dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:divider="@drawable/divider"
        android:showDividers="middle">

        <Button
            android:id="@+id/buttonWalk5000Steps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Walk 5.000 Steps"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonWalk10000Steps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Walk 10.000 Steps"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonDrinkWater"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Drink 2L Water"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonClean"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Clean"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonGoForAWalk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Go for a Walk"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonMeditate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Meditate"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonWorkout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Do a Workout"
            android:background="@drawable/step_count_border"
            />
        <Button
            android:id="@+id/buttonOwnDailyGoal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Enter own Daily Goal"
            android:background="@drawable/step_count_border"
            />
        <TextView
            android:id="@+id/txtChosenDailyGoal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Your choice:"
            android:textAlignment="center"
            android:textSize="20dp"
            />

    </LinearLayout>
    <Button
        android:id="@+id/buttonSaveDailyTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Goal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:onClick="saveGoalButtonClicked"
        android:background="@drawable/step_count_border"
        android:layout_marginBottom="20dp"
        android:layout_margin="10dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>