<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/questionnaire_popup_linearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#650E0808"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/questionnaire_popup_textinput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/questionnaire_popup_HintText"
        app:layout_constraintTop_toTopOf="@id/questionnaire_popup_linearLayout"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp" />


    <Button
        android:id="@+id/questionnaire_popup_AcceptButton"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/questionnaire_popup_AcceptButton"
        app:layout_constraintTop_toBottomOf="@+id/questionnaire_popup_textinput"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="161dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
