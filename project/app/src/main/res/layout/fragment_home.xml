<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="Home Screen"
                android:textSize="20sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout

                android:id="@+id/linearLayoutHomeUpper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:divider="@drawable/divider_big"
                android:gravity="center"
                android:orientation="horizontal"
                android:showDividers="middle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHomeTitle">

                <LinearLayout
                    android:id="@+id/linearLayoutHomeLittleBeing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/buttonLittleBeing">

                    <Button
                        android:id="@+id/btHomeQuestionnaire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:onClick="QuestionnaireClicked"
                        android:text="Questionnaire" />

                    <Button
                        android:id="@+id/btHomeDailyGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:onClick="PickDailyGoalClicked"
                        android:text="Pick Daily Goal" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/buttonLittleBeing"
                    android:layout_width="132dp"
                    android:layout_height="210dp"
                    android:background="@drawable/little_being" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewStepCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Today's Steps: "
                android:textSize="20sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="@id/linearLayoutHomeDailyGoal"
                app:layout_constraintTop_toBottomOf="@id/linearLayoutHomeUpper"
                android:background="@drawable/progress_bar_background"/>

            <LinearLayout
                android:id="@+id/linearLayoutHomeDailyGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:divider="@drawable/divider"
                android:gravity="center"
                android:orientation="vertical"
                android:showDividers="middle"

                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewStepCount">

                <TextView
                    android:id="@+id/DailyGoalTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Daily Goal Here"
                    android:textSize="20sp" />

                <ProgressBar
                    android:id="@+id/DailyGoalProgressBar"
                    style="?android:progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/progress_bar_background" />

                <Button
                    android:id="@+id/btHomeGoalComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="markGoalAsCompleteClicked"
                    android:text="Mark Goal as Complete" />

            </LinearLayout>

            <Button
                android:id="@+id/SeeAllPastActivitiesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:onClick="seeAllPastActivitiesClicked"
                android:text="See all past activities"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutHomeDailyGoal" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>