<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".HomeFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Home Screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/QuestionnaireButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Questionnaire"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:onClick="QuestionnaireClicked"
        android:layout_marginTop="-250dp"
        />

    <Button
        android:id="@+id/DailyGoalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick Daily Goal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/QuestionnaireButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:onClick="PickDailyGoalClicked"
        android:layout_marginTop="-250dp"
         />
    <TextView
        android:id="@+id/DailyGoalTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Display Daily Goal Here"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/DailyGoalButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="-100dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>