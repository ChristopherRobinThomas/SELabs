<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OverviewFragment">

    <EditText
        android:id="@+id/etLowerBoundTimePicker"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:clickable="false"
        android:cursorVisible="false"
        android:ems="10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.androidplot.pie.PieChart
        android:id="@+id/plt_pieChart"
        style="@style/APDefacto.Light"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="40dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:backgroundColor="#00FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/_Bindestrich"
        app:layout_constraintVertical_bias="0.0" />

    <com.androidplot.xy.XYPlot
        android:id="@+id/plt_graph"
        style="@style/APDefacto.Dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="40dp"
        android:background="#00FFFFFF"
        app:backgroundColor="#00FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/_Bindestrich"
        app:layout_constraintVertical_bias="0.0"
        app:titleTextColor="#000000" />

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btHealthIndex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/bt_overview_health_index"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btIntervention"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/bt_overview_interventions_graph"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btDistributionOfDailytasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/bt_overview_task_distribution"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etUpperBoundTimePicker"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:clickable="false"
        android:cursorVisible="false"
        android:ems="10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/_Bindestrich"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="5dp"
        android:text="@string/tv_overview_bindestrich"
        app:layout_constraintEnd_toStartOf="@+id/etLowerBoundTimePicker"
        app:layout_constraintStart_toEndOf="@+id/etUpperBoundTimePicker"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNothingToSeeHere"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_overview_no_data"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/activity_graph"
        app:layout_constraintEnd_toEndOf="@+id/activity_graph"
        app:layout_constraintStart_toStartOf="@+id/activity_graph"
        app:layout_constraintTop_toTopOf="@+id/activity_graph"
        tools:visibility="invisible" />

</androidx.constraintlayout.widget.ConstraintLayout>