<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/singleInterventionConstraintLayout"
                android:layout_width="match_parent"
                android:layout_height="728dp">

                <Button
                    android:id="@+id/buttonIntervention1"
                    android:layout_width="407dp"
                    android:layout_height="58dp"
                    android:background="@android:color/transparent"
                    android:onClick="openSingleInterventionFragment"
                    android:outlineAmbientShadowColor="#000000"
                    android:outlineProvider="none"
                    android:text="Intervention Name"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="invisible" />

                <Button
                    android:id="@+id/buttonIntervention2"
                    android:layout_width="407dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="58dp"
                    android:background="@android:color/transparent"
                    android:onClick="openSingleInterventionFragment"
                    android:outlineAmbientShadowColor="#000000"
                    android:outlineProvider="none"
                    android:text="Intervention Name"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="invisible" />

                <Button
                    android:id="@+id/buttonIntervention3"
                    android:layout_width="407dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="116dp"
                    android:background="@android:color/transparent"
                    android:onClick="openSingleInterventionFragment"
                    android:outlineAmbientShadowColor="#000000"
                    android:outlineProvider="none"
                    android:text="Intervention Name"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="invisible" />

                <Button
                    android:id="@+id/buttonAddNewIntervention"
                    android:layout_width="148dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="244dp"
                    android:layout_marginTop="652dp"
                    android:text="Add New Intervention"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>